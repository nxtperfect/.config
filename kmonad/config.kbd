(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-COMPANY_USB_Device-if02-event-kbd" :ignore-missing true)
  ;; input  (device-file "/dev/input/by-id/usb-COMPANY_USB_Device-event-kbd" :ignore-missing true)
  output (uinput-sink "My KMonad output"
    )
  cmp-seq ralt    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press
  key-seq-delay 5 ;; 5ms delay between each outputted key event

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd false

  ;; Set the implicit around to `around`
  implicit-around around
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12        ssrq slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     del  end  pgdn  kp7  kp8  kp9  kp+
  caps a    s    d    f    g    h    j    k    l    ;    '    ret                        kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up         kp1  kp2  kp3  kprt
  lctl lmet lalt           spc            ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(defalias
  lct_a (tap-hold-next-release 200 a lctl)
  lsf_s (tap-hold-next-release 200 s lsft)
  lal_d (tap-hold-next-release 200 d lalt)
  lme_f (tap-hold-next-release 200 f lmet)

  met_j (tap-hold-next-release 200 j rmet)
  ral_k (tap-hold-next-release 200 k ralt)
  rsf_l (tap-hold-next-release 200 l rsft)
  rct_; (tap-hold-next-release 200 ; rctl)

  ;;up_mod (tap-hold-next-release 200 up)
  ;;down_mod (tap-hold-next-release 200 down)
  ;;left_mod (tap-hold-next-release 200 left)
  ;;right_mod (tap-hold-next-release 200 right)

  nav (layer-switch nav)
  dev (layer-switch dev)
)

(deflayer nav
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  @dev        ssrq slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     del  end  pgdn  kp7  kp8  kp9  kp+
  caps @lct_a    @lsf_s    @lal_d    @lme_f    g    h    @met_j    @ral_k    @rsf_l    @rct_;    '    ret                        kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up         kp1  kp2  kp3  kprt
  lctl lmet lalt           spc            ralt rmet cmp  rctl            left down rght  kp0  kp.
)

(deflayer dev
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  @nav        ssrq slck pause
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  ins  home pgup  nlck kp/  kp*  kp-
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     del  end  pgdn  kp7  kp8  kp9  kp+
  caps a    s    d    f    g    h    j    k    l    ;    '    ret                        kp4  kp5  kp6
  lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up         kp1  kp2  kp3  kprt
  lctl lmet lalt           spc            ralt rmet cmp  rctl            left down rght  kp0  kp.
)
